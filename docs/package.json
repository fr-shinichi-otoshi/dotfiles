{
  "name": "dotfiles-docs",
  "version": "0.1.0",
  "private": true,
  "description": "WSL・Ubuntu向けのローカル開発環境を案内する日本語ドキュメントサイト。",
  "scripts": {
    "build": "docusaurus build",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check",
    "clear": "docusaurus clear",
    "format": "node scripts/prettier.mjs --write",
    "format:check": "node scripts/prettier.mjs --check",
    "lint": "pnpm lint:js && pnpm lint:css && pnpm lint:text",
    "lint:css": "node scripts/stylelint.mjs",
    "lint:css:fix": "node scripts/stylelint.mjs --fix",
    "lint:js": "node scripts/eslint.mjs",
    "lint:text": "node scripts/textlint.mjs",
    "lint:text:full": "node scripts/textlint.mjs --no-cache",
    "serve": "docusaurus serve --host 127.0.0.1",
    "start": "docusaurus start --host 127.0.0.1",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome versions",
      "last 3 firefox versions",
      "last 3 safari versions"
    ]
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-packagejson": "3.0.3",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "textlint": "15.8.0",
    "textlint-rule-preset-ai-writing": "1.1.0",
    "textlint-rule-preset-ja-spacing": "3.0.4",
    "textlint-rule-preset-ja-technical-writing": "12.0.2",
    "textlint-rule-prh": "6.1.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.1"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13"
  }
}
